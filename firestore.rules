rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Hardcoded admin email from user context
      return isEmailVerified() && request.auth.token.email == 'limon2581444@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Login Attempt Validation
    function isValidLoginAttempt(data) {
      return data.email is string && data.email.size() <= 256 &&
             data.password is string && data.password.size() <= 256 &&
             data.time is string && data.time.size() <= 100 &&
             data.createdAt == request.time;
    }

    match /login_attempts/{attemptId} {
      allow create: if isValidLoginAttempt(incoming()) && isValidId(attemptId);
      
      // Only admins can see the logs
      allow list, get: if isAdmin();
      
      // Admins can manage logs
      allow delete: if isAdmin();
      allow update: if false; // Logs should be immutable
    }
  }
}
